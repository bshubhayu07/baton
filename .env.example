# Baton Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & JWT
JWT_SECRET=baton-super-secret-jwt-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For Docker Compose (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://baton:baton_secret@postgres:5432/baton_db
# For local dev without Docker (SQLite fallback)
# DATABASE_URL=sqlite:///./baton.db

# AI Provider Settings (MOCK, OPENAI, or GEMINI)
LLM_PROVIDER=MOCK
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=MOCK
EMBEDDING_MODEL=text-embedding-3-small

# Demo Seed
AUTO_SEED_DEMO=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
